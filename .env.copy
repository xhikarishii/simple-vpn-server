# --- VPN Gateway Configuration ---
# Your server's public IP address or Domain Name
SERVER_ENDPOINT=1.2.3.4

# --- Security & Authentication ---
# A long, random string used to sign JWT tokens for the dashboard
JWT_SECRET=change-this-to-a-very-long-random-string

# Set to 'production' for server deployment to enable security hardening
NODE_ENV=production

# --- Dashboard Networking ---
# The port where the Nginx dashboard will listen (HTTP redirect)
NGINX_PORT=8877

# The backend host (use vpn-server-debug for local bridge testing, or 127.0.0.1 for host mode)
BACKEND_HOST=127.0.0.1
